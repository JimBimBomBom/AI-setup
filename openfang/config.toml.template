# OpenFang Agent OS — Generated Configuration
# DO NOT edit this file. Edit config.toml.template instead.
# Regenerate with: ./openfang/setup.sh
#
# Template variables filled from .env:
#   OLLAMA_MODEL   — which Ollama model to use (run ./list-models.sh to see options)
#   DISCORD_BOT_TOKEN — Discord bot token (injected as env var, not stored here)

# API server — bind on all interfaces so the scheduler sidecar can reach it
api_listen = "0.0.0.0:4200"

# Uncomment to require an API key for all REST API access
# api_key = "change_me"

# ── LLM: Local Ollama ────────────────────────────────────────────────────────
# Model is set from OLLAMA_MODEL in .env.
# OpenFang also auto-discovers all models available at the Ollama endpoint,
# so any pulled model appears in the dashboard and can be used per-agent.
[default_model]
provider    = "ollama"
model       = "${OLLAMA_MODEL}"
api_key_env = "OLLAMA_API_KEY"   # dummy — Ollama doesn't require auth
base_url    = "http://host.docker.internal:11434/v1"

[provider_urls]
ollama = "http://host.docker.internal:11434/v1"

# ── Memory ───────────────────────────────────────────────────────────────────
[memory]
decay_rate = 0.05

# ── Discord bot adapter ───────────────────────────────────────────────────────
# Shares DISCORD_BOT_TOKEN with OpenClaw — one bot for both services.
# The scheduler sidecar also posts via webhook (DISCORD_WEBHOOK_URL) for
# scheduled digests, independently of this adapter.
[discord]
bot_token_env = "DISCORD_BOT_TOKEN"
guild_ids     = []   # empty = all guilds the bot is a member of
