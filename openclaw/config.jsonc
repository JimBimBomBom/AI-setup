// OpenClaw Gateway Configuration
// Reference: https://openclaw.im/gateway/configuration
//
// Mounted read-only at ~/.openclaw/config.json inside the container.
// Environment variables in ${VAR} syntax are substituted by OpenClaw at load time.
// DISCORD_BOT_TOKEN is passed as an env var — never put it in this file.
{
  // ── LLM: Local Ollama (OpenAI-compatible API) ─────────────────────────────
  // No `models` array = OpenClaw calls /v1/models to discover available models
  // automatically. Whatever is pulled in Ollama is instantly available here.
  // Set OLLAMA_MODEL in .env to choose which one the agent defaults to.
  models: {
    mode: "merge",
    providers: {
      "ollama-local": {
        baseUrl: "http://host.docker.internal:11434/v1",
        api: "openai-chat",
        authHeader: false,
      },
    },
  },

  // Default model — reads from OLLAMA_MODEL env var set in .env
  // Run ./list-models.sh to see what's available on your Ollama instance.
  model: "ollama-local/${OLLAMA_MODEL}",

  // ── Discord bot ───────────────────────────────────────────────────────────
  // Token comes from DISCORD_BOT_TOKEN env var passed to the container.
  // DMs are disabled — the bot only posts outbound via cron jobs.
  // Cron jobs target the specific channel via --to "channel:DISCORD_CHANNEL_ID".
  channels: {
    discord: {
      enabled: true,
      dm: { enabled: false },
      groupPolicy: "open",
      chunkMode: "newline",
      textChunkLimit: 1900,
    },
  },

  // ── Cron scheduler ────────────────────────────────────────────────────────
  // Jobs are registered via init-cron.sh after first start.
  cron: {
    enabled: true,
    maxConcurrentRuns: 1,
    sessionRetention: "24h",
    retry: {
      maxAttempts: 3,
      backoffMs: [60000, 120000, 300000],
      retryOn: ["rate_limit", "overloaded", "network", "server_error"],
    },
    runLog: { maxBytes: "5mb", keepLines: 5000 },
  },

  // ── Agent defaults ────────────────────────────────────────────────────────
  agents: {
    defaults: {
      skills: ["news-digest"],
    },
  },
}
