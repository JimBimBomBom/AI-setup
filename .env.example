# Copy this file to .env and fill in your values.
# All services read from this single file.
# DO NOT commit .env to git.

# ── Timezone ──────────────────────────────────────────────────────────────────
# Used by all services for cron scheduling.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/Oslo

# ── OpenFang workflow scheduler ───────────────────────────────────────────────
# ID of the agent that should own cron jobs. Retrieve via:
#   curl http://localhost:4200/api/agents | jq '.[].id'
# Required once per deployment.
SCHEDULER_AGENT_ID=
# Shared secret for webhook delivery from OpenFang → scheduler container.
# Generate with: openssl rand -hex 16
SCHEDULER_WEBHOOK_TOKEN=
# Internal HTTP port for the scheduler's webhook relay (default: 8080)
SCHEDULER_HTTP_PORT=9090

# ── Ollama model ──────────────────────────────────────────────────────────────
# The model used by OpenClaw and OpenFang for summarization.
# Run ./list-models.sh to see what's available on your Ollama instance.
# Must be pulled first: ollama pull <model>
#
# Hardware: RTX 5060 Ti (16GB) + RTX 3090 (24GB)
#
# Recommended models:
#   qwen3.5:14b      — Best balance: fast, smart, fits on one GPU (~9GB)
#   qwen3.5:27b      — More capable but slower (~17GB, fits on 3090)
#   qwen3.5:9b       — Fastest, lower quality (~6GB)
#   gemma3:12b       — Good alternative (~8GB)
OLLAMA_MODEL=qwen3.5:14b

# ── Discord ───────────────────────────────────────────────────────────────────
# Webhook URL — used by n8n and OpenFang to post news digests.
# Create at: Discord Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Test webhook for n8n's test/cron-test workflows (can be same as above)
TEST_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_TEST_ID/YOUR_TEST_TOKEN

# Bot token — used by OpenClaw and OpenFang's Discord adapter.
# Create at: discord.com/developers → New Application → Bot → Add Bot → Copy Token
# Enable: Message Content Intent + Server Members Intent (under Bot → Privileged Intents)
# Invite bot: OAuth2 URL Generator → scopes: bot, applications.commands
#             permissions: Send Messages, Read Message History, View Channels
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Channel ID — OpenClaw posts news digests here.
# Enable Developer Mode (User Settings → Advanced), then right-click channel → Copy Channel ID
DISCORD_CHANNEL_ID=your_discord_channel_id

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change_me_to_secure_password

# Generate with: openssl rand -hex 16
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_16

# Set false for local/LAN access (no HTTPS)
N8N_SECURE_COOKIE=false

# ── Optional ──────────────────────────────────────────────────────────────────
# Email (n8n optional):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
# SMTP_SSL=true

# OpenFang REST API key (protects port 4200 if exposed externally):
# Generate with: openssl rand -hex 32
# OPENFANG_API_KEY=
